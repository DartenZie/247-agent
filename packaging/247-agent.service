# systemd unit for the 247-agent daemon, installed from a release tarball under
# /opt/247-agent (docs/operations/production.md, docs/internal/packaging.md). Copy to /etc/systemd/system/, then add
# the secrets the tasks name as LoadCredential= lines in a drop-in (`systemctl edit
# 247-agent`), one per secret, and set `secrets: { backend: systemd-credentials }` in
# agent.yaml:
#
#   [Service]
#   LoadCredential=anthropic_api_key:/etc/credstore/anthropic_api_key
#   LoadCredential=imap_pass:/etc/credstore/imap_pass
#
# Add ReadWritePaths= for any other directory a shell task writes to (a site checkout).
# TimeoutStopSec= must stay above `shutdown.grace` in agent.yaml plus 10 seconds; raise
# both together. Type=notify: `systemctl start` returns once the daemon has loaded its
# config, opened the database and bound its socket. It sends each notification through a
# systemd-notify child, hence NotifyAccess=all. WatchdogSec=: a daemon whose event loop
# stops answering for a minute is killed and restarted. TimeoutStartSec= leaves room for a
# database migration on start.
[Unit]
Description=247-agent core
Documentation=file:///opt/247-agent/share/doc/operations/production.md https://github.com/DartenZie/247-agent/blob/main/docs/operations/production.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=247-agent
Group=247-agent
ExecStart=/opt/247-agent/bin/247-agent-core --config /etc/247-agent/agent.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=90
WatchdogSec=60
RuntimeDirectory=247-agent
StateDirectory=247-agent
StateDirectoryMode=0750
ProtectSystem=strict
ReadWritePaths=/var/lib/247-agent
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
