#!/bin/sh
# Launcher for the connector host, what a 247-agent-connector@<name> unit runs. In a
# release tree (the tarball from scripts/build-release.sh) it runs the bundled build under
# the vendored Node; in a source checkout it runs the workspace build (npm run build) under
# the Node on PATH. Either way OA_HOME names the install root, so the host can put its
# siblings in bin/ first on PATH for the connector it runs.
set -e
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
root=$(cd "$(dirname "$self")/.." && pwd -P)
export OA_HOME="$root"
if [ -x "$root/node/bin/node" ] && [ -f "$root/lib/connector-host.mjs" ]; then
  exec "$root/node/bin/node" "$root/lib/connector-host.mjs" "$@"
fi
exec node "$root/packages/core/dist/host-main.js" "$@"
