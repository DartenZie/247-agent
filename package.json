{
  "name": "247-agent",
  "version": "0.0.0",
  "private": true,
  "description": "A 24/7, config-driven automation daemon for a single Linux server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "connectors/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "start": "node packages/core/dist/main.js",
    "oa": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
