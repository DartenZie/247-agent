{
  "name": "247-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A 24/7, config-driven automation daemon for a single Linux server.",
  "license": "WTFPL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "connectors/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests",
    "test:linux": "scripts/linux-test.sh",
    "smoke:acp": "node test/smoke/acp/run.mjs",
    "smoke:connectors": "node test/smoke/connectors/run.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "release": "scripts/build-release.sh",
    "package": "scripts/build-package.sh",
    "start": "node packages/core/dist/main.js",
    "oa": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
